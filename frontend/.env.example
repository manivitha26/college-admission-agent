# frontend/.env.example
# ──────────────────────────────────────────────────────────────────────────
# Copy this file to frontend/.env.local for local development overrides.
# Variables prefixed with VITE_ are embedded into the production bundle
# at build time (vite build).  Never put secrets here.
# ──────────────────────────────────────────────────────────────────────────

# Backend API base URL.
#
# Leave EMPTY when running behind nginx (docker-compose / IBM Code Engine
# frontend container) — the nginx proxy rewrites /api/* to the backend.
#
# Set to the full backend URL ONLY when the frontend is served from a
# different origin than the backend, for example:
#
#   https://college-backend.YOUR_REGION.codeengine.appdomain.cloud
#
VITE_API_BASE_URL=
