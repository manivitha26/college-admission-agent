# =============================================================================
#  College Admission Agent — environment variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# IBM watsonx.ai credentials  (required for the chatbot to work)
# -----------------------------------------------------------------------------

# Your IBM Cloud API key.
# How to get it: IBM Cloud → Manage → Access (IAM) → API keys → Create
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# The ID of your watsonx.ai project.
# How to get it: watsonx.ai → Projects → <your project> → Manage → General
#                The Project ID is shown under "Project details".
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Regional endpoint for your IBM Cloud account.
# Dallas (us-south) is the default.  Change if your account is in another region:
#   Frankfurt : https://eu-de.ml.cloud.ibm.com
#   Tokyo     : https://jp-tok.ml.cloud.ibm.com
#   London    : https://eu-gb.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# -----------------------------------------------------------------------------
# IBM Granite model (optional — default shown below)
# -----------------------------------------------------------------------------

# Model ID as shown in the watsonx.ai model catalogue.
# Other available Granite chat models:
#   ibm/granite-3-8b-instruct      (faster, smaller)
#   ibm/granite-13b-chat-v2        (default — good balance)
#   ibm/granite-20b-multilingual   (multilingual support)
GRANITE_MODEL_ID=ibm/granite-13b-chat-v2

# -----------------------------------------------------------------------------
# Embedding model (runs locally — no API key required)
# -----------------------------------------------------------------------------

# Sentence-transformers model used to embed document chunks and questions.
# The model is downloaded once (~90 MB) and cached in ~/.cache/huggingface/.
# You can use any model from https://huggingface.co/sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# Storage paths  (relative to the backend/ directory)
# -----------------------------------------------------------------------------

# Where ChromaDB stores its SQLite database and vector index files.
CHROMA_PERSIST_DIR=./data/vectorstore

# Where uploaded PDF files are saved.
PDF_UPLOAD_DIR=./data/pdfs

# -----------------------------------------------------------------------------
# ChromaDB collection name  (optional)
# -----------------------------------------------------------------------------
CHROMA_COLLECTION=college_admission_docs

# -----------------------------------------------------------------------------
# RAG tuning parameters  (optional — defaults shown)
# -----------------------------------------------------------------------------

# Size of each text chunk in characters (800 works well for most PDFs).
CHUNK_SIZE=800

# Overlap between consecutive chunks to preserve cross-boundary context.
CHUNK_OVERLAP=150

# Number of chunks retrieved per question and sent to Granite as context.
# Increase for broader answers; decrease to reduce prompt size / API cost.
RETRIEVAL_TOP_K=4
