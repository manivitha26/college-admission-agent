# backend/.dockerignore
# Files that should never be copied into the backend Docker image.

# Virtual environments — installed by pip inside the container
.venv/
venv/
env/

# Secrets — NEVER bake into an image
.env
*.env
!.env.example

# Persisted data — mounted as volumes at runtime, not baked in
data/vectorstore/
data/pdfs/
data/hf_cache/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp
*.log
